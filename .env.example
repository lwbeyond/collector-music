# Optional overrides (read from the process environment; not auto-loaded from this file)
# Node.js executable for the NetEase adapter (default: node on PATH)
# MUSIC_NODE_EXE=C:\path\to\node.exe
# adb executable for USB receive (default: --adb argument, then adb on PATH)
# MUSIC_ADB_EXE=C:\path\to\adb.exe
# Dashboard URL used by tests/dashboard.browser.mjs
# MUSIC_DASHBOARD_URL=http://127.0.0.1:8767
